+const SHORT_TOKEN_ALPHABET = "abcdefghijkmnpqrstuvwxyz23456789";
+// 256 is a multiple of 32, so `byte % 32` is unbiased
+const shortToken = (length = 10) =>
+  Array.from(crypto.getRandomValues(new Uint8Array(length)), (b) => SHORT_TOKEN_ALPHABET[b % 32]).join("");
