+// Generic OIDC login (Cal.diy-Docker patch), e.g. Authentik or Keycloak.
+// OIDC_ISSUER is the issuer URL; its /.well-known/openid-configuration must be reachable.
+const OIDC_ISSUER = process.env.OIDC_ISSUER?.replace(/\/+$/, "");
+if (
+  process.env.OIDC_LOGIN_ENABLED === "true" &&
+  OIDC_ISSUER &&
+  process.env.OIDC_CLIENT_ID &&
+  process.env.OIDC_CLIENT_SECRET
+) {
+  // Only set OIDC_TRUST_EMAIL when the IdP controls the e-mail addresses (no self-service changes)
+  const trustEmail = process.env.OIDC_TRUST_EMAIL === "true";
+  const oidcProvider = {
+    id: "oidc",
+    name: process.env.OIDC_NAME || "SSO",
+    type: "oauth" as const,
+    wellKnown: `${OIDC_ISSUER}/.well-known/openid-configuration`,
+    clientId: process.env.OIDC_CLIENT_ID,
+    clientSecret: process.env.OIDC_CLIENT_SECRET,
+    authorization: { params: { scope: process.env.OIDC_SCOPES || "openid email profile" } },
+    idToken: true,
+    checks: ["pkce", "state"] as ("pkce" | "state")[],
+    allowDangerousEmailAccountLinking: true,
+    profile(profile: Record<string, unknown>) {
+      const email = typeof profile.email === "string" ? profile.email.toLowerCase() : null;
+      const name =
+        (typeof profile.name === "string" && profile.name) ||
+        (typeof profile.preferred_username === "string" && profile.preferred_username) ||
+        email;
+      return {
+        id: String(profile.sub),
+        name,
+        email,
+        image: null,
+        ...((trustEmail || profile.email_verified === true) && { emailVerified: new Date() }),
+      };
+    },
+  };
+  // cast: next-auth types User.id as number via packages/types/next-auth.d.ts, OAuth ids are strings
+  providers.push(oidcProvider as unknown as Provider);
+}
