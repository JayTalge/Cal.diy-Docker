+// Generic OIDC login (Cal.diy-Docker patch), e.g. Authentik or Keycloak.
+// OIDC_ISSUER is the issuer URL; its /.well-known/openid-configuration must be reachable.
+const OIDC_ISSUER = process.env.OIDC_ISSUER?.replace(/\/+$/, "");
+// Comma-separated IdP group names (claim "groups") whose members get the cal role ADMIN; empty = roles untouched
+const OIDC_ADMIN_GROUPS = (process.env.OIDC_ADMIN_GROUPS || "")
+  .split(",")
+  .map((group) => group.trim())
+  .filter(Boolean);
+// Settings for users created by an OIDC login (cal defaults are Europe/London, Sunday, 12h)
+const OIDC_NEW_USER_DEFAULTS = {
+  ...(process.env.OIDC_DEFAULT_TIMEZONE && { timeZone: process.env.OIDC_DEFAULT_TIMEZONE }),
+  ...(process.env.OIDC_DEFAULT_LOCALE && { locale: process.env.OIDC_DEFAULT_LOCALE }),
+  ...(process.env.OIDC_DEFAULT_WEEK_START && { weekStart: process.env.OIDC_DEFAULT_WEEK_START }),
+  ...(process.env.OIDC_DEFAULT_TIME_FORMAT && { timeFormat: Number(process.env.OIDC_DEFAULT_TIME_FORMAT) }),
+};
+if (
+  process.env.OIDC_LOGIN_ENABLED === "true" &&
+  OIDC_ISSUER &&
+  process.env.OIDC_CLIENT_ID &&
+  process.env.OIDC_CLIENT_SECRET
+) {
+  // Only set OIDC_TRUST_EMAIL when the IdP controls the e-mail addresses (no self-service changes)
+  const trustEmail = process.env.OIDC_TRUST_EMAIL === "true";
+  const oidcProvider = {
+    id: "oidc",
+    name: process.env.OIDC_NAME || "SSO",
+    type: "oauth" as const,
+    wellKnown: `${OIDC_ISSUER}/.well-known/openid-configuration`,
+    clientId: process.env.OIDC_CLIENT_ID,
+    clientSecret: process.env.OIDC_CLIENT_SECRET,
+    authorization: { params: { scope: process.env.OIDC_SCOPES || "openid email profile" } },
+    idToken: true,
+    checks: ["pkce", "state"] as ("pkce" | "state")[],
+    allowDangerousEmailAccountLinking: true,
+    profile(profile: Record<string, unknown>) {
+      const email = typeof profile.email === "string" ? profile.email.toLowerCase() : null;
+      const name =
+        (typeof profile.name === "string" && profile.name) ||
+        (typeof profile.preferred_username === "string" && profile.preferred_username) ||
+        email;
+      return {
+        id: String(profile.sub),
+        name,
+        email,
+        image: null,
+        ...((trustEmail || profile.email_verified === true) && { emailVerified: new Date() }),
+      };
+    },
+  };
+  // cast: next-auth types User.id as number via packages/types/next-auth.d.ts, OAuth ids are strings
+  providers.push(oidcProvider as unknown as Provider);
+}
+
+// Sets the cal role from the IdP groups on every OIDC login (only when OIDC_ADMIN_GROUPS is set)
+const syncRoleFromOidcGroups = async (
+  groups: unknown,
+  user: { id: number; role: UserPermissionRole }
+): Promise<UserPermissionRole> => {
+  if (OIDC_ADMIN_GROUPS.length === 0) return user.role;
+  const userGroups = Array.isArray(groups) ? groups.filter((g): g is string => typeof g === "string") : [];
+  const role = userGroups.some((g) => OIDC_ADMIN_GROUPS.includes(g))
+    ? UserPermissionRole.ADMIN
+    : UserPermissionRole.USER;
+  if (role !== user.role) {
+    await prisma.user.update({ where: { id: user.id }, data: { role } });
+    log.info("OIDC role updated from IdP groups", { userId: user.id, role });
+  }
+  return role;
+};
+
+// Copies the IdP profile picture (OIDC claim "picture") into the cal avatar on every OIDC login.
+// Only https URLs on the issuer host are fetched, so a profile claim cannot make the server request other hosts.
+const updateProfilePhotoOidc = async (picture: unknown, userId: number) => {
+  if (typeof picture !== "string" || !OIDC_ISSUER) return;
+  try {
+    const url = new URL(picture);
+    if (url.protocol !== "https:" || url.host !== new URL(OIDC_ISSUER).host) return;
+    const response = await fetch(url, { signal: AbortSignal.timeout(10000) });
+    const contentType = response.headers.get("content-type") || "";
+    if (!response.ok || !contentType.startsWith("image/")) {
+      log.warn("OIDC profile picture not loaded", { status: response.status, contentType });
+      return;
+    }
+    const buffer = Buffer.from(await response.arrayBuffer());
+    if (buffer.length > 5 * 1024 * 1024) return;
+    const avatarUrl = await uploadAvatar({
+      avatar: await resizeBase64Image(`data:${contentType};base64,${buffer.toString("base64")}`),
+      userId,
+    });
+    await prisma.user.update({ where: { id: userId }, data: { avatarUrl } });
+  } catch (error) {
+    log.error("Error updating avatar from OIDC sign-in", safeStringify(error));
+  }
+};
